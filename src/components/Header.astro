---
const NAV = [
  {
    id: "servizi",
    label: "Servizi",
    href: "/servizi",
    children: [
      { label: "Fit Sprint", href: "/software-fit-sprint" },
      { label: "Web Evolution", href: "/website-evolution" },
      { label: "Software su misura", href: "/software-su-misura" },
      { label: "QA", href: "/qa" },
      { label: "UX Partner Dev", href: "/partner" },
    ],
  },
  { id: "metodo", label: "Metodo", href: "/metodo" },
  { id: "about", label: "Chi sono", href: "/about" },
  { id: "casi", label: "Casi", href: "/casi" },
  { id: "contatti", label: "Contatti", href: "/contatti" },
];

const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHere = (href: string) => href === here;
---

<header class="nav">
  <div class="shell">
    <a class="brand" href="/" data-nav aria-label="Miranda, home">
      <img class="mark" src="/assets/logo-mark-light.png" alt="" /><span class="word">Miranda</span>
    </a>
    <nav class="nav-links">
      {NAV.map((n) =>
        n.children ? (
          <div class="nav-item has-dd">
            <a
              href={n.href}
              class={"dd-trigger" + (isHere(n.href) || n.children.some((c) => isHere(c.href)) ? " active" : "")}
              data-nav
              aria-haspopup="true"
            >
              {n.label}<i data-lucide="chevron-down" class="dd-caret"></i>
            </a>
            <div class="dd-menu" role="menu">
              {n.children.map((c) => (
                <a href={c.href} class={isHere(c.href) ? "active" : ""} data-nav role="menuitem">
                  {c.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={n.href} class={isHere(n.href) ? "active" : ""} data-nav>
            {n.label}
          </a>
        )
      )}
    </nav>
    <div class="nav-cta">
      <a class="btn btn-primary" href="/contatti" data-nav><i data-lucide="calendar-check" class="ic"></i> Prenota la call</a>
      <button class="nav-toggle" aria-label="Apri il menu" aria-expanded="false"><i data-lucide="menu" class="ic" style="width:20px;height:20px"></i></button>
    </div>
  </div>
</header>

<div class="mobile-menu">
  <a href="/" data-nav>Home</a>
  <div class="m-group">
    <a href="/servizi" data-nav>Servizi</a>
    <div class="m-sub">
      <a href="/software-fit-sprint" data-nav>Fit Sprint</a>
      <a href="/website-evolution" data-nav>Web Evolution</a>
      <a href="/software-su-misura" data-nav>Software su misura</a>
      <a href="/qa" data-nav>QA</a>
      <a href="/partner" data-nav>UX Partner Dev</a>
    </div>
  </div>
  <a href="/metodo" data-nav>Metodo</a>
  <a href="/about" data-nav>About</a>
  <a href="/casi" data-nav>Casi</a>
  <a href="/contatti" data-nav>Contatti</a>
  <a class="btn btn-primary" href="/contatti" data-nav><i data-lucide="calendar-check" class="ic"></i> Prenota la call di triage</a>
</div>
