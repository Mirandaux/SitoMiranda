---
import Layout from "../layouts/Layout.astro";
import LeadMagnetMatrix from "../components/LeadMagnetMatrix.astro";
import FitSprintForm from "../components/FitSprintForm.astro";

const pageUrl = "https://www.mirandagiaccon.it/software-fit-sprint";
const studioId = "https://www.mirandagiaccon.it/#studio";

const faqs = [
  {
    q: "Che cos'è il Software Fit Sprint?",
    a: "Un percorso di due settimane per scegliere o validare un software che impatta più team. Invece di partire dalla demo, si parte dai processi reali: come si lavora oggi, dove si rompe il flusso, quali criteri contano davvero per chi dovrà usarlo ogni giorno."
  },
  {
    q: "Quanto dura e quanto costa?",
    a: "Due settimane, time-boxed. Prezzo fisso: €1.500, tutto incluso. Nessun \"da\", nessun extra. Sai in anticipo cosa ricevi e quando."
  },
  {
    q: "Cosa riceve concretamente l'azienda?",
    a: "Mappa dei processi as-is e to-be, criteri di scelta pesati con gli stakeholder, shortlist di 2-3 soluzioni o validazione di una scelta esistente, matrice decisionale con pro, contro, costi, limiti e un rischio per ogni riga, roadmap di adozione a 30, 90 e 180 giorni."
  },
  {
    q: "La valutazione è indipendente dai fornitori?",
    a: "Sì. Non ho accordi commerciali con vendor né commissioni su referral. La raccomandazione si basa sui processi reali dell'azienda e sui criteri definiti insieme agli stakeholder, non sulle demo o sui materiali di marketing dei tool."
  },
  {
    q: "Comprende sviluppo e configurazione?",
    a: "No. Il Software Fit Sprint produce una decisione e una roadmap, non esegue sviluppo né configurazione tecnica. Quando scelgo o valido un tool, la responsabilità dell'implementazione rimane al team interno o a un partner tecnico."
  },
  {
    q: "Per quali aziende è indicato?",
    a: "Per PMI, scaleup ed enti che devono scegliere un software che impatta più team, dove gli stakeholder faticano ad allinearsi sui criteri e il budget va difeso bene. Non è adatto se il fornitore è già scelto e manca solo l'esecuzione, o se si cerca sviluppo e configurazione tecnica."
  }
];

const sfsJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  "name": "Software Fit Sprint",
  "serviceType": "Consulenza per la selezione di software aziendale",
  "description": "In due settimane: mappa dei processi, criteri UX, shortlist, matrice decisionale con rischi e roadmap di adozione.",
  "url": pageUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
  "provider": { "@id": studioId },
  "areaServed": { "@type": "Country", "name": "Italy" },
  "audience": {
    "@type": "Audience",
    "audienceType": "PMI, scaleup, enti con processi digitali da ottimizzare"
  },
  "inLanguage": "it",
  "offers": {
    "@type": "Offer",
    "price": "1500",
    "priceCurrency": "EUR",
    "url": pageUrl,
    "seller": { "@id": studioId },
    "availability": "https://schema.org/InStock",
    "areaServed": { "@type": "Country", "name": "Italy" }
  }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a }
  }))
};
---

<Layout
  title="Miranda · Software Fit Sprint"
  description="State scegliendo un software e ogni reparto vuole qualcosa di diverso? In due settimane: mappa processi, criteri condivisi, matrice decisionale con rischi. €1.500 fisso."
  page="servizi"
  bg='data-max="120" data-link="150" data-accent="0.10" data-speed="0.13"'
>
  <script type="application/ld+json" set:html={JSON.stringify(sfsJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- HERO -->
  <section class="page-hero">
    <div class="shell">
      <div class="hero-grid">
        <div>
          <div class="row reveal" style="gap:10px;margin-bottom:18px;">
            <span class="pill wine"><span class="dot"></span>Software Fit Sprint</span>
            <span class="pill">€1.500 fisso</span>
            <span class="pill">2 settimane</span>
          </div>
          <h1 class="reveal d1">State scegliendo un gestionale, ma ogni reparto vuole qualcosa di diverso?</h1>
          <p class="lede reveal d2">Aiuto PMI e team a trasformare una scelta bloccata in una decisione difendibile. Due settimane, prezzo fisso: mappa dei processi, criteri condivisi, matrice con rischi e roadmap di adozione.</p>
          <div class="cta-row reveal d3">
            <a class="btn btn-primary btn-lg magnetic" href="#richiedi-confronto" data-track="sfs_cta_hero"><i data-lucide="send" class="ic"></i> Raccontami cosa state cercando di scegliere</a>
            <a class="btn btn-secondary btn-lg magnetic" href="#caso-reale" data-track="sfs_cta_caso">Vedi un caso reale</a>
          </div>
        </div>
        <div class="reveal d2">
          <div class="holo glow-wine scanlines tilt" data-tilt data-console>
            <div class="console-head">
              <div class="lights"><i style="background:#7c223f"></i><i style="background:#b7791f"></i><i style="background:#2e855a"></i></div>
              <div class="console-title" data-status="Settimana 1 · mappatura|Settimana 1 · criteri|Settimana 2 · shortlist|Settimana 2 · matrice|Output · decisione">Sprint timeline</div>
              <div class="console-title" style="color:var(--eyebrow-dark)">SFS-01</div>
            </div>
            <div class="console-body">
              <div class="flow">
                <span class="node"><i data-lucide="route" class="ic"></i> Mappa</span><span class="arr">→</span>
                <span class="node"><i data-lucide="git-branch" class="ic"></i> Criteri</span><span class="arr">→</span>
                <span class="node"><i data-lucide="box" class="ic"></i> Shortlist</span><span class="arr">→</span>
                <span class="node"><i data-lucide="check-square" class="ic"></i> Decisione</span>
              </div>
              <div class="rm" style="background:transparent;border:0;padding:0;">
                <ul style="gap:12px;">
                  <li><i data-lucide="circle-check"></i> stakeholder allineati sugli stessi criteri</li>
                  <li><i data-lucide="circle-check"></i> 2-3 tool confrontati con rischio per riga</li>
                  <li><i data-lucide="circle-check"></i> roadmap a 30 / 90 / 180 giorni</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CASO REALE -->
  <section class="section tight" id="caso-reale">
    <div class="shell">
      <div class="section-head reveal">
        <div class="eyebrow">Caso reale</div>
        <h2 class="h2-cinema">PMI manifatturiera. Due CRM in valutazione, quattro reparti con esigenze diverse.</h2>
        <p>Un caso concreto per capire cosa succede in due settimane di Software Fit Sprint.</p>
      </div>
      <div class="caso-grid reveal d1" style="margin-top:36px;">
        <div class="caso-card">
          <div class="caso-label">Prima</div>
          <p>L'azienda stava valutando due CRM dopo aver visto tre demo. Commerciale, produzione, amministrazione e customer care avevano aspettative diverse e nessuno strumento per confrontarle. La scelta si trascinava da mesi, il team era diviso e il rischio era firmare sulla base della demo più convincente.</p>
        </div>
        <div class="caso-card caso-card-center">
          <div class="caso-label">Intervento</div>
          <p>Mappa dei processi as-is e to-be per ciascun reparto coinvolto. Sessione di prioritizzazione con gli stakeholder per pesare i criteri: adozione operativa, integrazione con il gestionale esistente, costo totale a 24 mesi, lock-in. Analisi delle due opzioni con matrice decisionale completa di rischio per riga. Roadmap di adozione in tre fasi.</p>
        </div>
        <div class="caso-card caso-card-after">
          <div class="caso-label">Dopo</div>
          <p>Decisione presa e documentata con criteri difendibili in riunione. Il team ha aperto un solo portale ogni mattina invece di tre. Le attività dimenticate tra reparti sono diminuite. Le chiamate interne per coordinamento si sono ridotte. La scelta finale non era l'opzione "piu bella in demo", ma quella con il miglior rapporto adozione-integrazione per il loro flusso reale.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COSTO DELLA NON-DECISIONE -->
  <section class="section tight">
    <div class="shell">
      <div class="lead-2col">
        <div class="reveal">
          <div class="eyebrow">Il problema che rallenta tutto</div>
          <h2 class="h2-cinema" style="margin-top:14px;">Quando la scelta non arriva, il costo non si ferma.</h2>
        </div>
        <div class="reveal d1">
          <p style="font-size:17px;line-height:27px;margin-bottom:24px;">Il segnale che qualcosa non funziona di solito non è "non riusciamo a scegliere". E' piu sottile. Si riconosce così:</p>
          <ul class="sintomi-list">
            <li><i data-lucide="alert-triangle" class="ic" aria-hidden="true"></i> Ogni reparto porta argomenti diversi alle riunioni di valutazione e si riparte da zero.</li>
            <li><i data-lucide="alert-triangle" class="ic" aria-hidden="true"></i> Avete visto tre demo convincenti e non riuscite a capire quale tool fa davvero al caso vostro.</li>
            <li><i data-lucide="alert-triangle" class="ic" aria-hidden="true"></i> Il team operativo dice una cosa, il CTO un'altra, la direzione una terza. Nessuno ha torto, ma nessuno si allinea.</li>
            <li><i data-lucide="alert-triangle" class="ic" aria-hidden="true"></i> State pagando abbonamenti a tool usati a meta perché l'adozione non è mai decollata.</li>
            <li><i data-lucide="alert-triangle" class="ic" aria-hidden="true"></i> La decisione è urgente ma ogni settimana che passa senza una scelta costa tempo e coordinamento.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- PER CHI / NON PER CHI -->
  <section class="section tight">
    <div class="shell">
      <div class="section-head reveal"><div class="eyebrow">Per chi è, per chi no</div><h2 class="h2-cinema">Confini chiari da subito.</h2></div>
      <div class="fit-grid reveal d1" style="margin-top:32px;">
        <div class="fit yes">
          <h4><span class="mk"><i data-lucide="check" style="width:16px;height:16px"></i></span>È fit se</h4>
          <ul>
            <li><i data-lucide="check"></i> devi scegliere o validare un software che impatta più team</li>
            <li><i data-lucide="check"></i> gli stakeholder non si allineano sui criteri</li>
            <li><i data-lucide="check"></i> vuoi una decisione difendibile entro 4-8 settimane</li>
            <li><i data-lucide="check"></i> il budget è medio e va difeso bene</li>
          </ul>
        </div>
        <div class="fit no">
          <h4><span class="mk"><i data-lucide="minus" style="width:16px;height:16px"></i></span>Non è fit se</h4>
          <ul>
            <li><i data-lucide="x"></i> cerchi sviluppo o configurazione tecnica del tool</li>
            <li><i data-lucide="x"></i> vuoi una garanzia di uplift percentuale</li>
            <li><i data-lucide="x"></i> il fornitore è già scelto e manca solo l'esecuzione</li>
            <li><i data-lucide="x"></i> ti serve un sito vetrina entry-level</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- COSA SUCCEDE IN 2 SETTIMANE -->
  <section class="section tight">
    <div class="shell">
      <div class="section-head reveal"><div class="eyebrow">Cosa succede in pratica</div><h2 class="h2-cinema">Due settimane, time-boxed.</h2></div>
      <div class="steps">
        <div class="step reveal d1"><div class="n">0<span class="bg">1</span></div><div><h3>Mappo i processi reali</h3><p>Interviste rapide e osservazione. Come si lavora oggi, dove si rompe il flusso, dove un tool serve davvero e dove no.</p><div class="io"><span class="lbl">Input</span><span class="pill">accesso a 3-5 persone</span><span class="lbl">Output</span><span class="pill">mappa as-is / to-be</span></div></div></div>
        <div class="step reveal d1"><div class="n">0<span class="bg">2</span></div><div><h3>Definisco criteri e vincoli</h3><p>UX, budget, integrazione, adozione. I criteri che reggono anche in CDA, non quelli che piacciono al fornitore.</p><div class="io"><span class="lbl">Input</span><span class="pill">vincoli e budget</span><span class="lbl">Output</span><span class="pill">criteri pesati</span></div></div></div>
        <div class="step reveal d1"><div class="n">0<span class="bg">3</span></div><div><h3>Valuto opzioni e trade-off</h3><p>Shortlist di 2-3 soluzioni o validazione di una scelta esistente. Matrice decisionale con un rischio per ogni riga.</p><div class="io"><span class="lbl">Input</span><span class="pill">2-3 tool</span><span class="lbl">Output</span><span class="pill">matrice + rischi</span></div></div></div>
        <div class="step reveal d1"><div class="n">0<span class="bg">4</span></div><div><h3>Consegno decisione e roadmap</h3><p>Una raccomandazione difendibile e un piano di adozione. Cosa fare entro 30, 90 e 180 giorni. Cosa non fare. Cosa rimandare.</p><div class="io"><span class="lbl">Decisione</span><span class="pill">scegli · valida · scarta</span><span class="lbl">Output</span><span class="pill">roadmap 30/90/180</span></div></div></div>
      </div>
    </div>
  </section>

  <!-- MATRICE -->
  <section class="section tight" id="matrice">
    <div class="shell">
      <div class="section-head reveal"><div class="eyebrow">Output centrale</div><h2 class="h2-cinema">La matrice decisionale. Sempre con una colonna rischio.</h2><p>Non un punteggio magico. Un confronto leggibile dagli stakeholder, dove ogni riga dice anche cosa può andare storto.</p></div>
      <div class="holo glow-blue reveal d1" style="margin-top:32px;" data-console>
        <div class="console-head">
          <div class="lights"><i style="background:#7c223f"></i><i style="background:#b7791f"></i><i style="background:#2e855a"></i></div>
          <div class="console-title">Matrice decisionale · esempio</div>
          <span class="console-tabs"><button data-tool="A" class="on">Evidenzia A</button><button data-tool="B">Evidenzia B</button></span>
        </div>
        <div class="console-body" style="padding:8px 20px 20px;">
          <table class="mtx">
            <thead><tr><th>Criterio</th><th>Peso</th><th data-col="A" class="win">Tool A</th><th data-col="B">Tool B</th><th>Rischio</th></tr></thead>
            <tbody>
              <tr><td class="crit">Adozione team operativo</td><td>Alto</td><td data-col="A" class="win"><span class="tag-ok">Alto</span></td><td data-col="B"><span class="tag-mid">Medio</span></td><td>Curva di apprendimento su B</td></tr>
              <tr><td class="crit">Costo totale 24 mesi</td><td>Alto</td><td data-col="A" class="win"><span class="tag-mid">€42k</span></td><td data-col="B"><span class="tag-ok">€31k</span></td><td>Personalizzazioni su B</td></tr>
              <tr><td class="crit">Integrazione gestionale</td><td>Medio</td><td data-col="A" class="win"><span class="tag-ok">Nativa</span></td><td data-col="B"><span class="tag-no">Esterna</span></td><td>Middleware da mantenere</td></tr>
              <tr><td class="crit">Tempo a regime</td><td>Medio</td><td data-col="A" class="win"><span class="tag-ok">6 sett.</span></td><td data-col="B"><span class="tag-mid">10 sett.</span></td><td>Formazione interna</td></tr>
              <tr><td class="crit">Lock-in fornitore</td><td>Basso</td><td data-col="A" class="win"><span class="tag-mid">Medio</span></td><td data-col="B"><span class="tag-ok">Basso</span></td><td>Export dati su A</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- DELIVERABLES + ANTI-SCOPE -->
  <section class="section tight">
    <div class="shell">
      <div class="section-head reveal"><div class="eyebrow">Cosa consegno</div><h2 class="h2-cinema">Output concreti, niente slide di teoria.</h2></div>
      <div class="scope-grid reveal d1" style="margin-top:32px;">
        <div class="scope inc">
          <h4><i data-lucide="circle-check"></i> Cosa consegno</h4>
          <ul>
            <li>mappa dei processi as-is e to-be</li>
            <li>colli di bottiglia identificati</li>
            <li>criteri di scelta guidati dalla UX, pesati con gli stakeholder</li>
            <li>shortlist di 2-3 soluzioni o validazione di una scelta esistente</li>
            <li>matrice decisionale con pro, contro, costi, limiti e rischi</li>
            <li>roadmap di adozione a 30 / 90 / 180 giorni</li>
          </ul>
        </div>
        <div class="scope exc">
          <h4><i data-lucide="circle-slash"></i> Cosa non include</h4>
          <ul>
            <li>sviluppo e configurazione tecnica</li>
            <li>negoziazione con il vendor</li>
            <li>PM dell'implementazione</li>
            <li>supporto continuativo dopo la roadmap</li>
          </ul>
          <p class="note">Il valore è decidere cosa ha senso fare, prima di investire in esecuzione. Whatever it takes, anche mappare i processi prima di guardare la demo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PREZZO + RISCHIO -->
  <section class="section tight">
    <div class="shell">
      <div class="offers" style="grid-template-columns:1fr 1fr;">
        <div class="holo reveal d1" style="padding:36px;">
          <div class="eyebrow">Tempi e prezzo</div>
          <div class="price" style="margin-top:16px;align-items:baseline;display:flex;gap:10px;"><b style="font-family:var(--font-heading);font-size:44px;font-weight:800;color:#fff;">€1.500</b><span style="color:var(--on-dark-3)">fisso</span></div>
          <p style="margin-top:8px;">Due settimane time-boxed. Prezzo fisso, nessun "da". Sai in anticipo cosa ricevi e quando.</p>
        </div>
        <div class="holo glow-wine reveal d2" style="padding:36px;">
          <div class="eyebrow">Riduzione del rischio</div>
          <h3 style="margin-top:14px;font-size:22px;">€1.500 una tantum, contro un tool sbagliato pagato per 24 mesi.</h3>
          <p style="margin-top:10px;">Una decisione difendibile costa una frazione di un acquisto sbagliato e della sua mancata adozione. Se non c'è abbastanza materiale per decidere, te lo dico nella call di triage.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section tight" id="faq">
    <div class="shell">
      <div class="section-head reveal"><div class="eyebrow">Domande frequenti</div><h2 class="h2-cinema">Quello che di solito si chiede prima di iniziare.</h2></div>
      <div class="faq-list reveal d1" style="margin-top:32px;">
        {faqs.map(({ q, a }) => (
          <details class="faq-item">
            <summary class="faq-q">
              <span>{q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <p class="faq-a">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <style>
    /* Case study */
    .caso-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    .caso-card {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 14px;
      padding: 28px 24px;
    }
    .caso-card-center {
      border-color: rgba(124,34,63,0.35);
      background: rgba(124,34,63,0.07);
    }
    .caso-card-after {
      border-color: rgba(110,207,151,0.2);
      background: rgba(110,207,151,0.04);
    }
    .caso-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      color: var(--eyebrow-dark);
      margin-bottom: 14px;
    }
    .caso-card p {
      font-size: 15px;
      line-height: 25px;
      color: var(--on-dark-2);
      margin: 0;
    }
    @media (max-width: 860px) {
      .caso-grid { grid-template-columns: 1fr; }
    }

    /* Sintomi */
    .sintomi-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 14px;
    }
    .sintomi-list li {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      font-size: 15.5px;
      line-height: 24px;
      color: var(--on-dark-2);
    }
    .sintomi-list .ic {
      width: 17px;
      height: 17px;
      color: var(--eyebrow-dark);
      flex-shrink: 0;
      margin-top: 3px;
    }

    /* FAQ */
    .faq-list { display: grid; gap: 0; border-top: 1px solid rgba(255,255,255,0.08); }
    .faq-item { border-bottom: 1px solid rgba(255,255,255,0.08); }
    .faq-q {
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      padding: 20px 0;
      font-size: 16px;
      font-weight: 600;
      color: #fff;
      cursor: pointer;
      user-select: none;
    }
    .faq-q::-webkit-details-marker { display: none; }
    .faq-icon {
      font-size: 22px;
      font-weight: 300;
      color: var(--eyebrow-dark);
      flex-shrink: 0;
      transition: transform 0.2s;
      line-height: 1;
    }
    .faq-item[open] .faq-icon { transform: rotate(45deg); }
    .faq-a {
      margin: 0 0 20px;
      font-size: 15px;
      line-height: 25px;
      color: var(--on-dark-2);
      max-width: 72ch;
    }
    @media (max-width: 600px) {
      .faq-q { font-size: 15px; }
    }
  </style>

  <!-- LEAD MAGNET matrice -->
  <LeadMagnetMatrix />

  <!-- FORM LEAD SFS -->
  <FitSprintForm />

  <!-- CTA secondaria (Calendly) -->
  <section class="section tight">
    <div class="shell">
      <div class="cta-band reveal" style="padding-top:32px;padding-bottom:32px;">
        <p style="color:var(--on-dark-3);font-size:15px;margin:0 0 14px;">Preferisci parlare direttamente?</p>
        <div class="cta-row"><a class="btn btn-secondary btn-lg magnetic" href="https://calendly.com/mirandauxdesigner/30min" target="_blank" rel="noopener"><i data-lucide="calendar-check" class="ic"></i> Prenota la call di triage su Calendly</a></div>
      </div>
    </div>
  </section>

  <!-- Funnel analytics tracking -->
  <script>
    import { track } from "@vercel/analytics";

    function initSfsTracking() {
      // ── CTA click events (hero + secondary) ──────────────────────────────
      document.querySelectorAll("[data-track]").forEach((el) => {
        el.addEventListener("click", () => {
          const event = (el as HTMLElement).dataset.track;
          if (event) track(event);
        }, { once: true });
      });

      // Calendly link clicks (any link pointing to calendly.com on the page)
      document.querySelectorAll<HTMLAnchorElement>('a[href*="calendly.com"]').forEach((el) => {
        el.addEventListener("click", () => {
          track("sfs_calendly_click");
        }, { once: true });
      });

      // ── Scroll-reach events (IntersectionObserver) ───────────────────────
      const reaches: [string, string][] = [
        ["sfs_reach_caso_reale", "#caso-reale"],
        ["sfs_reach_form", "#richiedi-confronto"],
      ];
      if ("IntersectionObserver" in window) {
        reaches.forEach(([event, selector]) => {
          const el = document.querySelector(selector);
          if (!el) return;
          const obs = new IntersectionObserver(
            (entries) => {
              if (entries[0]?.isIntersecting) {
                track(event);
                obs.disconnect();
              }
            },
            { threshold: 0.2 }
          );
          obs.observe(el);
        });
      }

      // ── Form interaction events ───────────────────────────────────────────
      const firstField = document.querySelector<HTMLElement>(
        ".sfs-form input:not([type=hidden]):not([type=checkbox]), .sfs-form textarea, .sfs-form select"
      );
      if (firstField) {
        firstField.addEventListener("focus", () => {
          track("sfs_form_start");
        }, { once: true });
      }

      const form = document.querySelector<HTMLFormElement>(".sfs-form");
      if (form) {
        // Submit attempt (fires before validation, counts intent)
        form.addEventListener("submit", () => {
          track("sfs_form_submit");
        });

        // Success response from server
        const successEl = document.querySelector<HTMLElement>(".sfs-success");
        if (successEl) {
          const observer = new MutationObserver(() => {
            if (successEl.style.display !== "none" && successEl.style.display !== "") {
              track("sfs_form_success");
              observer.disconnect();
            }
          });
          observer.observe(successEl, { attributes: true, attributeFilter: ["style"] });
        }

        // Server-side or network error shown to user
        const globalErr = form.querySelector<HTMLElement>(".sfs-global-err");
        if (globalErr) {
          const errObserver = new MutationObserver(() => {
            if (globalErr.style.display !== "none" && globalErr.textContent?.trim()) {
              track("sfs_form_error");
            }
          });
          errObserver.observe(globalErr, { attributes: true, attributeFilter: ["style"] });
        }
      }
    }

    document.addEventListener("astro:page-load", initSfsTracking);
    initSfsTracking();
  </script>
</Layout>
