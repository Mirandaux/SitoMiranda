    .lb-close { position:fixed;top:20px;right:24px;background:rgba(10,10,14,0.8);border:1px solid var(--hairline);border-radius:50%;color:#fff;font-size:18px;width:40px;height:40px;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:10000; }
  </style>

  <script>
    const lb = document.getElementById('sordo-lightbox');
    const img = document.getElementById('sordo-flusso-img');
    const btn = document.getElementById('sordo-zoom-btn');
    const closeBtn = document.getElementById('sordo-lb-close');
    function openLb() { lb?.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function closeLb() { lb?.classList.remove('open'); document.body.style.overflow = ''; }
    img?.addEventListener('click', openLb);
    btn?.addEventListener('click', openLb);
    closeBtn?.addEventListener('click', closeLb);
    lb?.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLb(); });
  </script>

