---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CockpitBg from "../components/CockpitBg.astro";
import Analytics from "@vercel/analytics/astro";
import "../styles/cockpit.css";
import "../styles/hero-immersive.css";

interface Props {
  title: string;
  description: string;
  page: string;
  bg?: string;
  immersiveHero?: boolean;
  ogImage?: string;
}

const { title, description, page, bg, immersiveHero = false, ogImage } = Astro.props;

const siteUrl = "https://www.mirandagiaccon.it";
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImg = ogImage ?? `${siteUrl}/assets/miranda-chisono.jpeg`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#miranda`,
      "name": "Miranda Giaccon",
      "jobTitle": "UX & Product Consultant",
      "description": "Aiuto PMI, scaleup ed enti a prendere buone decisioni su software e processi digitali, prima che diventino costose.",
      "url": siteUrl,
      "email": "info@mirandagiaccon.it",
      "sameAs": ["https://www.linkedin.com/in/miranda-giaccon/"],
      "knowsAbout": [
        "UX Design", "Product Management", "Process Mapping",
        "Software Selection", "Adoption Strategy", "UX Audit",
        "Accessibility", "Decision Making"
      ],
      "image": `${siteUrl}/assets/portrait-miranda.webp`,
      "nationality": { "@type": "Country", "name": "Italy" }
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#studio`,
      "name": "Miranda · UX & Product Consulting",
      "url": siteUrl,
      "description": "Consulenza UX e di prodotto per PMI, scaleup ed enti: scelta software, progettazione processi digitali, QA UX e adozione.",
      "founder": { "@id": `${siteUrl}/#miranda` },
      "areaServed": { "@type": "Country", "name": "Italy" },
      "priceRange": "€1.500 per Software Fit Sprint; altri servizi su preventivo",
      "image": {
        "@type": "ImageObject",
        "url": `${siteUrl}/assets/portrait-miranda.webp`
      },
      "serviceType": [
        "Software Fit Sprint",
        "Website Evolution Check",
        "Progettazione software su misura",
        "UX/UI QA & Functional Testing",
        "CRO / Adoption Sprint"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Offerte",
        "url": `${siteUrl}/servizi`
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "info@mirandagiaccon.it",
        "contactType": "customer service",
        "availableLanguage": "Italian"
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Miranda · UX & Product Consulting",
      "description": "Consulenza UX e di prodotto per PMI, scaleup ed enti: scelta software, progettazione processi digitali, QA UX e adozione.",
      "inLanguage": "it",
      "publisher": { "@id": `${siteUrl}/#miranda` }
    },
    {
      "@type": "WebPage",
      "@id": canonical,
      "url": canonical,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "about": { "@id": `${siteUrl}/#miranda` },
      "inLanguage": "it"
    }
  ]
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Miranda Giaccon" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Miranda · UX & Product Consulting" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Miranda Giaccon · UX & Product Consultant" />
    <meta property="og:locale" content="it_IT" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />
    <meta name="twitter:image:alt" content="Miranda Giaccon · UX & Product Consultant" />

    <!-- Favicon -->
    <link rel="icon" href="/assets/logo-mark.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/logo-mark.png" />

    <!-- JSON-LD strutturati -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-page={page}>

    <!-- Skip to content (accessibilità) -->
    <a class="skip-link" href="#main-content">Salta al contenuto</a>

    {immersiveHero && <div class="amb" id="amb"><div class="spot"></div><div class="spot b"></div></div>}
    <CockpitBg bg={bg} />
    <div class="curtain"></div>
    <div data-progress style="position:fixed;top:0;left:0;height:2px;width:0;z-index:60;background:linear-gradient(90deg,#7c223f,#b06a7e);box-shadow:0 0 12px rgba(176,106,126,.6);transition:width 80ms linear;"></div>
    <Header />
    <main class="page" id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      import { createIcons, icons } from "lucide";
      // Espone il global per compatibilità con chrome.js e script inline
      (window as any).lucide = {
        createIcons: (opts?: any) => createIcons({ icons, ...opts }),
      };
      createIcons({ icons });
    </script>
    <script src="../scripts/cockpit-bg.js"></script>
    {immersiveHero && <script src="../scripts/hero-immersive.js"></script>}
    <script src="../scripts/chrome.js"></script>
    <Analytics />
  </body>
</html>
